{
    "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "node",
      "outDir": "./public",       // 👈 AQUÍ se guardará el JavaScript compilado
      "rootDir": "./src",         // 👈 AQUÍ escribirás tus archivos TypeScript
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"]
  }
  